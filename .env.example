# FixPilot AI Environment Variables

# Required
GEMINI_API_KEY=your_gemini_api_key_here
FIXPILOT_MODEL=gemini-1.5-flash
FIXPILOT_LOG_LEVEL=INFO
FIXPILOT_DB_PATH=artifacts/fixpilot.sqlite3
FIXPILOT_SANDBOX_IMAGE=fixpilot-sandbox:latest
FIXPILOT_MAX_RETRIES=2
FIXPILOT_TIMEOUT_SECONDS=120
FIXPILOT_APPROVAL_REQUIRED=true

# Optional
FIXPILOT_ANALYSIS_ONLY=false