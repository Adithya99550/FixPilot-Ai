# FixPilot AI Environment Variables

# ---- Required ---------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here

# ---- Core -------------------------------------------------------------
FIXPILOT_MODEL=gemini-1.5-flash
FIXPILOT_LOG_LEVEL=INFO
FIXPILOT_DB_PATH=artifacts/fixpilot.sqlite3
FIXPILOT_REPORTS_DIR=reports
FIXPILOT_SANDBOX_IMAGE=fixpilot-sandbox:latest
FIXPILOT_MAX_RETRIES=2
FIXPILOT_TIMEOUT_SECONDS=120
FIXPILOT_APPROVAL_REQUIRED=true
FIXPILOT_ANALYSIS_ONLY=false

# ---- Safety -----------------------------------------------------------
# Every switch below is OFF by default. Turn them on only when you
# understand the trade-off.
#
# PROJECT_SPEC.md §9.3: a sandbox failure must be BLOCKED, never a silent
# fallback to running target project code on the host.
FIXPILOT_ALLOW_UNSAFE_LOCAL_EXECUTION=false
# Legacy alias for the above (honoured for backwards compatibility).
FIXPILOT_ALLOW_LOCAL_RUNNER=false

# Allow the sandbox container to reach the network.
FIXPILOT_ALLOW_NETWORK=false

# Allow dependency installation inside the sandbox.
FIXPILOT_ALLOW_DEPENDENCY_INSTALL=false
FIXPILOT_DEPENDENCY_INSTALL_NETWORK=false

# Allow a patch to create or delete files.
FIXPILOT_ALLOW_FILE_CREATION=false
FIXPILOT_ALLOW_FILE_DELETION=false

# Keep the disposable workspace after a run (for debugging).
FIXPILOT_KEEP_WORKSPACE=false

# ---- Multi-language ---------------------------------------------------
FIXPILOT_LANGUAGE=
FIXPILOT_TEST_FRAMEWORK=
FIXPILOT_TEST_COMMAND=
FIXPILOT_BUILD_COMMAND=
FIXPILOT_REPO_URL=
FIXPILOT_BRANCH=
FIXPILOT_COMMIT=

# ---- GitHub ------------------------------------------------------------
# Used for private repositories. It is sent as an Authorization header and
# is never written into a clone's .git/config.
GITHUB_TOKEN=
